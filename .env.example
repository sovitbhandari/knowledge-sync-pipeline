# PostgreSQL (matches docker-compose.yml defaults)
# If host port 5432 is already in use, set POSTGRES_PORT/DATABASE_URL to 5433.
DATABASE_URL=postgresql://ksp:ksp_dev_password@localhost:5432/knowledge_sync
POSTGRES_USER=ksp
POSTGRES_PASSWORD=ksp_dev_password
POSTGRES_DB=knowledge_sync
POSTGRES_PORT=5432

# API server
API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Sync worker
SYNC_LEASE_TTL_SECONDS=60
SYNC_MAX_RETRIES=5
SYNC_RETRY_BASE_MS=200
SYNC_RETRY_MAX_MS=10000
